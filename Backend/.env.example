# Valores apenas para desenvolvimento local. Troque todas as senhas e chaves antes de usar em outro ambiente.
POSTGRES_DB=guapi_verde
POSTGRES_USER=guapi_verde_dev
POSTGRES_PASSWORD=troque-esta-senha-do-postgres
POSTGRES_PORTA_EXTERNA=5440

# Use uma chave longa e aleatoria em ambientes reais (HS256 exige pelo menos 256 bits).
JWT_CHAVE=exemplo-desenvolvimento-chave-jwt-hs256-com-mais-de-32-caracteres
JWT_EXPIRACAO_MINUTOS=120

ADMIN_NOME=Administrador Guapi Verde
ADMIN_EMAIL=admin@example.com
ADMIN_SENHA=troque-esta-senha-do-admin

CORS_ORIGENS=http://localhost:5173,http://localhost:3000
